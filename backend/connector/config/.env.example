# =============================================================================
# .env.example - Plantilla de variables de entorno del conector
# =============================================================================
# Copia este archivo a ".env" (mismo directorio) y rellena los valores reales.
# .env NO se sube a Git (esta en .gitignore). Ahi van los secretos.

# Ruta al archivo JSON de credenciales de la cuenta de servicio de Google Cloud.
# Ejemplo: V:\DashBoard\clave_json.json  (en el PC-servidor) o el que uses aqui.
GOOGLE_APPLICATION_CREDENTIALS=

# (Opcional) Identificadores de Google Cloud si no usas la cuenta por defecto.
# BIGQUERY_PROJECT_ID=dashboard-439511
